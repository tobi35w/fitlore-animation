SCHEDULEPOST_API_KEY=
VIDEO_OUTPUT_DIR=../Rendered Videos
# immediate, queue, or schedule; schedule requires scheduled_for in each video's metadata.
PUBLISH_MODE=immediate
YOUTUBE_PRIVACY=public
TIKTOK_POST_MODE=DIRECT_POST
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
TIMEZONE=Africa/Lagos
DRY_RUN=true
AUTO_PUBLISH=false
YOUTUBE_CONNECTION_ID=
TIKTOK_CONNECTION_ID=
REQUIRE_READY_MARKER=true
STABILITY_SECONDS=15
SCAN_INTERVAL=10
POLL_INTERVAL=60
MAX_ATTEMPTS=5
MAX_FILE_BYTES=536870912
MAX_VIDEO_SECONDS=180
DEFAULT_HASHTAGS=#shorts
